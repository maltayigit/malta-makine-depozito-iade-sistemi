# ── Sunucu ────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5500

# ── PostgreSQL ────────────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGDATABASE=machine_management_db
PGUSER=postgres
PGPASSWORD=postgres
# İsteğe bağlı: yukarıdaki 5 alan yerine tek satır bağlantı adresi
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/machine_management_db
PGSSL=false

# ── JWT ───────────────────────────────────────────────────
JWT_ACCESS_SECRET=degistir-bu-cok-gizli-access-anahtari
JWT_REFRESH_SECRET=degistir-bu-cok-gizli-refresh-anahtari
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── İlk kurulum (seed) için Super Admin ──────────────────
SEED_SUPER_ADMIN_USERNAME=admin
SEED_SUPER_ADMIN_PASSWORD=1234a
SEED_SUPER_ADMIN_FULLNAME=Sistem Yoneticisi
SEED_SUPER_ADMIN_EMAIL=admin@maltamakine.com

